PROJECT_NAME="Veronica Central Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & Tokens
SECRET_KEY="your-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =========================================================================
# DATABASE_URL (Switch between any cloud or local DB with zero code changes)
# =========================================================================
# 1. Local Docker / Localhost Postgres:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/veronica_db"

# 2. Free Cloud Supabase (AWS Mumbai ap-south-1):
# DATABASE_URL="postgresql+asyncpg://postgres.yourprojectid:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# 3. Future Paid Cloud (AWS RDS / GCP Cloud SQL / DigitalOcean):
# DATABASE_URL="postgresql+asyncpg://admin:yourpassword@veronica-db.yourid.ap-south-1.rds.amazonaws.com:5432/veronica"
